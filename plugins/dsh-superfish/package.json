{
  "name": "@local/dsh-superfish",
  "version": "1.0.0",
  "description": "嗨，我是大肥鱼！平时帮你记待办、盯进度、定提醒，有活儿也能帮你安排下去，让每天的事儿都井井有条。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "icon.png",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preset": {
      "types": "./lib/types/sessions/preset.d.ts",
      "default": "./lib/preset.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./schedule-host": {
      "types": "./lib/types/schedule-host/index.d.ts",
      "default": "./lib/schedule-host/index.js"
    },
    "./schedule-host/locale/zh.json": "./locale/schedule-host/zh.json",
    "./schedule-host/locale/en.json": "./locale/schedule-host/en.json",
    "./schedule-host/icon": "./icon.png",
    "./genui": {
      "types": "./lib/types/genui/index.d.ts",
      "default": "./lib/genui/index.js"
    },
    "./genui/locale/zh.json": "./locale/genui/zh.json",
    "./genui/locale/en.json": "./locale/genui/en.json",
    "./genui/icon": "./icon.png",
    "./workspace-context": {
      "types": "./lib/types/workspace-context/index.d.ts",
      "default": "./lib/workspace-context/index.js"
    },
    "./workspace-context/locale/zh.json": "./locale/workspace-context/zh.json",
    "./workspace-context/locale/en.json": "./locale/workspace-context/en.json",
    "./workspace-context/icon": "./icon.png",
    "./workspace-context/task-board": {
      "types": "./lib/types/workspace-context/task-board.d.ts",
      "default": "./lib/workspace-context/task-board.js"
    },
    "./workspace-context/task-board/locale/zh.json": "./locale/workspace-context-task-board/zh.json",
    "./workspace-context/task-board/locale/en.json": "./locale/workspace-context-task-board/en.json",
    "./workspace-context/task-board/icon": "./icon.png",
    "./workspace-context/schedule": {
      "types": "./lib/types/workspace-context/schedule.d.ts",
      "default": "./lib/workspace-context/schedule.js"
    },
    "./workspace-context/schedule/locale/zh.json": "./locale/workspace-context-schedule/zh.json",
    "./workspace-context/schedule/locale/en.json": "./locale/workspace-context-schedule/en.json",
    "./workspace-context/schedule/icon": "./icon.png",
    "./workspace-context/session": {
      "types": "./lib/types/workspace-context/session.d.ts",
      "default": "./lib/workspace-context/session.js"
    },
    "./workspace-context/session/locale/zh.json": "./locale/workspace-context-session/zh.json",
    "./workspace-context/session/locale/en.json": "./locale/workspace-context-session/en.json",
    "./workspace-context/session/icon": "./icon.png",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./icon": "./icon.png",
    "./icon.png": "./icon.png",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "skills",
    "icon.png",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-time": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@js-temporal/polyfill": "0.5.1",
    "react": "18.3.1",
    "zod": ">=4.4.3 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "typescript": "5.7.3",
    "tsdown": "0.22.2"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs"
  }
}
