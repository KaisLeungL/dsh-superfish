{
  "name": "@local/dsh-superfish-genui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenTiny GenUI SDK middleware plugin for DSH SuperFish (大肥鱼, @local/dsh-superfish), providing dynamic MaterialMeta prompt generation, streaming JSON repair, and extensible React Material/Action registries.",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
